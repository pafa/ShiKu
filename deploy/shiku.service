[Unit]
Description=Shiku museum (single admission queue)
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/shiku/current
ExecStart=/usr/bin/node /srv/shiku/current/server/museum.mjs --host 127.0.0.1 --port 4173
Environment=SHIKU_PUBLIC_ORIGIN=https://shiku.xiaoha.org
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077

[Install]
WantedBy=multi-user.target
